{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "browser": true,
    "node": true
  },
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "warn"
  },
  "plugins": ["eslint", "oxc", "import", "typescript", "unicorn", "jsdoc", "vitest", "node", "promise"],
  "rules": {
    "eqeqeq": "error",
    "no-unused-vars": "warn",
    "no-undef": "off",
    "no-debugger": "warn",
    "no-console": "off",
    "no-var": "error",
    "prefer-const": "warn",
    "no-throw-literal": "error",
    "no-unreachable": "error",
    "max-lines": "off",
    "max-lines-per-function": "off",
    "max-classes-per-file": "off",
    "jsdoc/require-param": "off",
    "jsdoc/require-returns": "off",
    "typescript/prefer-readonly-parameter-types": "off"
  },
  "ignorePatterns": ["node_modules/", "dist/"]
}
