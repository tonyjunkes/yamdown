{
  "name": "@tonyjunkes/yamdown",
  "version": "0.11.4",
  "description": "Markdown-superset annotations and structured YAML for deterministic, machine-manipulable Markdown.",
  "keywords": [
    "converter",
    "documentation",
    "generator",
    "markdown",
    "markdown-superset",
    "mdast",
    "remark",
    "structured-authoring",
    "unified",
    "yaml"
  ],
  "homepage": "https://github.com/tonyjunkes/yamdown",
  "bugs": {
    "url": "https://github.com/tonyjunkes/yamdown/issues"
  },
  "license": "MIT",
  "author": "Tony Junkes (https://tonyjunkes.dev)",
  "repository": {
    "type": "git",
    "url": "https://github.com/tonyjunkes/yamdown.git"
  },
  "bin": {
    "yamdown": "dist/cli.mjs"
  },
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "files": [
    "dist",
    "schema",
    "FORMAT.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./schema.json": "./schema/yamdown.schema.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:github": "oxlint --format=github",
    "schema:generate": "pnpm run build && node scripts/generate-schema.mjs",
    "schema:check": "pnpm run build && node scripts/check-schema.mjs",
    "pack:check": "pnpm pack --dry-run",
    "test:package": "node scripts/smoke-package.mjs",
    "prepack": "pnpm run schema:check",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run fmt:check && pnpm run test && pnpm run schema:check && pnpm run test:package"
  },
  "dependencies": {
    "@types/mdast": "^4.0.4",
    "commander": "^15.0.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.1.2",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "5.0.0",
    "ajv": "^8.20.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@12.4.1"
}
