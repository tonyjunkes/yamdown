{
  "name": "yamdown",
  "version": "0.8.1",
  "private": true,
  "description": "Structured YAML authoring for deterministic Markdown output.",
  "keywords": [
    "converter",
    "documentation",
    "generator",
    "markdown",
    "mdast",
    "remark",
    "structured-authoring",
    "unified",
    "yaml"
  ],
  "homepage": "https://github.com/tonyjunkes/yamdown#readme",
  "bugs": {
    "url": "https://github.com/tonyjunkes/yamdown/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonyjunkes/yamdown.git"
  },
  "bin": {
    "yamdown": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./schema.json": "./schema/yamdown.schema.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:github": "oxlint --format=github",
    "schema:generate": "pnpm run build && node scripts/generate-schema.mjs",
    "pack:check": "pnpm pack --dry-run",
    "test:package": "node scripts/smoke-package.mjs",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run fmt:check && pnpm run test && pnpm run build && pnpm run test:package"
  },
  "dependencies": {
    "@types/mdast": "^4.0.4",
    "commander": "^15.0.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@typescript/native-preview": "npm:typescript@7.0.1-rc",
    "@vitest/coverage-v8": "4.1.9",
    "ajv": "^8.20.0",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.23.0",
    "tsdown": "^0.22.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882"
}
